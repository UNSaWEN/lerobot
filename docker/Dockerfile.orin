# LeRobot Dockerfile for NVIDIA Orin (JetPack 6 / L4T r36.4.0)
# 基于 dustynv/lerobot 镜像，安装 lerobot v0.5.2 源码 + 自定义 SO101 样例
#
# 构建:
#   docker build --network=host -f docker/Dockerfile.orin -t lerobot-orin .
#
# 验证:
#   ./docker/run-orin.sh bash docker/verify-orin.sh
#
# 详细说明见 docker/README.orin.md

# 使用 dustynv 的 lerobot 镜像作为基础
# 该镜像已针对 Jetson Orin 优化，包含:
# - CUDA 12.8
# - PyTorch (Jetson 优化版, 通常 2.7–2.8)
# - 系统级依赖 (OpenCV, ffmpeg 等)
FROM dustynv/lerobot:r36.4.0-cu128-24.04

WORKDIR /opt/lerobot

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    MUJOCO_GL=egl \
    DIFFUSERS_FORCE_DISABLE_TRITON=1

# 安装额外的系统依赖
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    libusb-1.0-0-dev \
    usbutils \
    speech-dispatcher \
    espeak \
    ffmpeg \
    v4l-utils \
    libgeos-dev \
    portaudio19-dev \
    pkg-config \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# 升级 lerobot 到工作区最新版本 (v0.5.2)
# 策略参考 dusty-nv/jetson-containers:
#   1. 从 pyproject.toml 剥离基础镜像已提供的重量级依赖
#   2. 以 --no-deps 安装 lerobot 本体，避免 pip 覆盖 Jetson PyTorch
#   3. 通过 requirements-orin.txt 补装 SO101 所需轻量依赖
#   4. 跳过 torchcodec (aarch64 需要 torch>=2.11，与 Jetson PyTorch 不兼容)
# ============================================================

# 删除基础镜像自带的旧版 lerobot 源码 (保留 PyTorch 等重量级依赖)
RUN rm -rf /opt/lerobot/lerobot

COPY src/lerobot/ /opt/lerobot/src/lerobot/
COPY pyproject.toml /opt/lerobot/pyproject.toml
COPY setup.py /opt/lerobot/setup.py
COPY MANIFEST.in /opt/lerobot/MANIFEST.in
COPY README.md /opt/lerobot/README.md
COPY docker/requirements-orin.txt /opt/lerobot/docker/requirements-orin.txt

# setuptools 79.x 需要显式配置 dynamic readme
RUN sed -i '/^\[tool\.setuptools\.packages\.find\]/i \
[tool.setuptools.dynamic]\nreadme = {file = "README.md"}\n' pyproject.toml

# 剥离基础镜像已提供的包，避免 pip 从 PyPI 拉取不兼容的 aarch64 wheel
RUN sed -i \
    -e '/"torch[^"]*",/d' \
    -e '/"torchvision[^"]*",/d' \
    -e '/"opencv-python[^"]*",/d' \
    -e '/torchcodec/d' \
    pyproject.toml

# 安装 lerobot 本体 (不解析/安装依赖)
RUN pip install --no-cache-dir -e . \
    --no-build-isolation \
    --no-deps \
    --extra-index-url https://pypi.org/simple/

# 补装 SO101 所需的 Python 依赖 (不含 torch/torchvision/torchcodec)
RUN pip install --no-cache-dir -r docker/requirements-orin.txt \
    --extra-index-url https://pypi.org/simple/

# 复制自定义样例代码
COPY examples/phone_to_so101/ /opt/lerobot/examples/phone_to_so101/
COPY examples/so101_to_so101_EE/ /opt/lerobot/examples/so101_to_so101_EE/
COPY docker/verify-orin.sh /opt/lerobot/docker/verify-orin.sh
RUN chmod +x /opt/lerobot/docker/verify-orin.sh

ENV PYTHONPATH="/opt/lerobot/examples:/opt/lerobot/src:${PYTHONPATH}"

RUN mkdir -p /data/models/huggingface /data/datasets \
    && ln -sf /data/models/huggingface /root/.cache/huggingface 2>/dev/null || true

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import torch; import lerobot; assert torch.cuda.is_available(), 'CUDA not available'" || exit 1

CMD ["/bin/bash"]
